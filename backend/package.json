{
  "name": "backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:gateway": "tsx apps/gateway/src/index.ts",
    "dev:profile": "tsx apps/profile-service/src/index.ts",
    "dev:career": "tsx apps/career-service/src/index.ts",
    "dev:ai": "tsx apps/ai-service/src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "cd packages/database && pnpm generate",
    "db:migrate": "cd packages/database && pnpm migrate",
    "db:push": "cd packages/database && pnpm push",
    "db:seed": "cd packages/database && pnpm seed",
    "db:studio": "cd packages/database && pnpm studio"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
