generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────
// Auth (better-auth) — `students` doubles as the auth user table
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  legacyEmailVerified Boolean @default(false) @map("emailVerified")
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Student profile (better-auth additional fields)
  degree         String?
  university     String?
  cgpa           Float?
  graduationYear Int?

  sessions       Session[]
  legacySessions LegacySession[]
  accounts       Account[]
  legacyAccounts LegacyAccount[]
  skills         StudentSkill[]
  projects       Project[]
  internships    Internship[]
  certifications Certification[]
  analyses       CareerAnalysis[]
  roadmaps       Roadmap[]
  streak         Streak?

  @@map("students")
}

model LegacySession {
  id           String   @id
  expiresAt    DateTime
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  impersonatedBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LegacyAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────
// Profile domain
// ─────────────────────────────────────────────────────────────

model Skill {
  id           String          @id @default(cuid())
  name         String
  category     String          @default("General")
  createdAt    DateTime        @default(now())

  studentSkills StudentSkill[]
  projectSkills ProjectSkill[]
  careerSkills  CareerSkill[]
  roadmapTasks  RoadmapTask[]

  @@unique([name])
  @@map("skills")
}

model StudentSkill {
  id         String   @id @default(cuid())
  studentId  String
  skillId    String
  proficiency Int
  confidence Int?
  source     String   @default("self")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([studentId])
  @@map("student_skills")
}

model Project {
  id          String   @id @default(cuid())
  studentId   String
  name        String
  description String?
  githubUrl   String?
  demoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skills  ProjectSkill[]

  @@index([studentId])
  @@map("projects")
}

model ProjectSkill {
  id        String @id @default(cuid())
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@map("project_skills")
}

model Internship {
  id          String    @id @default(cuid())
  studentId   String
  company     String
  role        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("internships")
}

model Certification {
  id            String   @id @default(cuid())
  studentId     String
  name          String
  issuer        String?
  credentialUrl String?
  createdAt     DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certifications")
}

// ─────────────────────────────────────────────────────────────
// Career domain
// ─────────────────────────────────────────────────────────────

enum Priority {
  high
  medium
  low
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Career {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  createdAt   DateTime      @default(now())

  skills     CareerSkill[]
  analyses   CareerAnalysis[]
  roadmaps   Roadmap[]

  @@map("careers")
}

model CareerSkill {
  id            String   @id @default(cuid())
  careerId      String
  skillId       String
  requiredLevel Int
  weight        Float    @default(1)
  priority      Priority @default(medium)

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerId, skillId])
  @@index([careerId])
  @@map("career_skills")
}

model CareerAnalysis {
  id             String   @id @default(cuid())
  studentId      String
  careerId       String
  readinessScore Int
  strengths      Json?
  gaps           Json?
  createdAt      DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  career  Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, careerId])
  @@map("career_analyses")
}

model Roadmap {
  id          String   @id @default(cuid())
  studentId   String
  careerId    String
  title       String
  description String?
  progress    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  career  Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  tasks   RoadmapTask[]

  @@index([studentId])
  @@map("roadmaps")
}

model RoadmapTask {
  id               String     @id @default(cuid())
  roadmapId        String
  title            String
  description      String?
  skillId          String?
  week             Int        @default(1)
  status           TaskStatus @default(todo)
  estimatedMinutes Int        @default(60)
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill   Skill?  @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@map("roadmap_tasks")
}

model Streak {
  studentId       String    @id
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityAt  DateTime?
  updatedAt       DateTime  @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

// Auth.js tables are separate from legacy Better Auth sessions and accounts.
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("auth_sessions")
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}
