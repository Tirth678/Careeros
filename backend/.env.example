# ── Database (Neon) ─────────────────────────────────────────────
# Use the pooled (pgbouncer) connection string for the app, and the
# direct endpoint string for `prisma migrate` if you hit pooling issues.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Service ports ────────────────────────────────────────────────
GATEWAY_PORT=3000
PROFILE_SERVICE_PORT=3001
CAREER_SERVICE_PORT=3002
AI_SERVICE_PORT=3003

# ── Service-to-service URLs (used by the gateway) ───────────────
PROFILE_SERVICE_URL="http://localhost:3001"
CAREER_SERVICE_URL="http://localhost:3002"
AI_SERVICE_URL="http://localhost:3003"

# ── Auth (better-auth) ──────────────────────────────────────────
# Public URL of the gateway — used for cookie/CORS correctness.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-64-char-random-hex"
# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173"

# ── AI (OpenRouter) ─────────────────────────────────────────────
OPENROUTER_API_KEY=""
# Any model id from GET https://openrouter.ai/api/v1/models. Accounts without
# credits must use a `:free` / zero-priced model (e.g. inclusionai/ling-3.1-flash).
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Optional: which model to fall back to if the primary fails.
OPENROUTER_FALLBACK_MODEL=""
# OpenRouter reserves credits against this ceiling; too high yields HTTP 402.
OPENROUTER_MAX_TOKENS=4000

# ── Gateway ─────────────────────────────────────────────────────
# Max requests per IP per window (rate limiting).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
